#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Ratchet: block commits only when tsc error count rises above baseline
BASELINE=$(cat "$(git rev-parse --show-toplevel)/.tsc-baseline" 2>/dev/null || echo 9999)
COUNT=$(npx --no-install tsc --noEmit 2>&1 | grep -c "error TS" || true)
if [ "$COUNT" -gt "$BASELINE" ]; then
  echo "tsc errors rose: was $BASELINE, now $COUNT — commit blocked"
  exit 1
fi
# Update baseline with new (equal or lower) count
echo "$COUNT" > "$(git rev-parse --show-toplevel)/.tsc-baseline"
npx lint-staged